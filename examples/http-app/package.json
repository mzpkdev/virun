{
  "name": "http-app",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "scripts": {
    "dev": "virun serve --target node --entry src/index.ts",
    "build": "virun build --target node --entry src/index.ts --module esm cjs",
    "build:esm": "virun build --target node --entry src/index.ts --module esm",
    "build:cjs": "virun build --target node --entry src/index.ts --module cjs",
    "build:preserve-modules": "virun build --target node --preserve-modules --module esm cjs --outdir src",
    "clean": "virun clean --outdir dist",
    "clean:preserve-modules": "virun clean --outdir src",
    "test": "virun test"
  },
  "dependencies": {},
  "devDependencies": {
    "virun": "file:../.."
  }
}